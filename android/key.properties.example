# Copy to android/key.properties and fill in. That file is gitignored; the build
# copies it into the generated client, so build/client is never edited by hand.
#
# Create the keystore once, and back it up somewhere permanent — losing it means
# never being able to update the Play listing again:
#
#   keytool -genkey -v -keystore ~/ruflet-explorer-upload.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# storeFile may be absolute, or relative to this file.
storePassword=
keyPassword=
keyAlias=upload
storeFile=
